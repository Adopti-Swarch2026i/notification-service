# Variables consumidas por notification-service (Go). Fuente única de
# verdad para Docker Compose (cargado vía env_file en
# Compose/docker-compose.yml).
#
# Para correr el servicio FUERA de Docker, sustituir hostnames Docker
# (rabbitmq, postgres-notifications) por localhost.

# ── Server ─────────────────────────────────────────
PORT=8082
LOG_LEVEL=info

# ── Broker de eventos ──────────────────────────────
RABBITMQ_URL=amqps://adopti:__RABBITMQ_PASSWORD__@rabbitmq:5671/

# ── Base de datos (historial de notificaciones) ────
POSTGRES_DSN=postgres://postgres:__PG_PASSWORD__@postgres-notifications:5432/notificationsdb?sslmode=verify-full&sslrootcert=/app/certs/ca.crt

# ── Firebase Admin (auth + FCM) ────────────────────
# El compose monta el JSON en /app/firebase-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json
FIREBASE_CREDENTIALS=/app/firebase-credentials.json

# ── SendGrid (email) ───────────────────────────────
# Obtener de: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.replace_with_actual_key
SENDGRID_FROM_EMAIL=notifications@your-domain.com

# ── Email de pruebas (fallback cuando no se resuelve uid → email) ──
TEST_EMAIL=test@example.com
