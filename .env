# Variables consumidas por notification-service (Go).
# Fuente unica de verdad para Docker Compose.

# -- Server --
PORT=8082
LOG_LEVEL=info

# -- Broker de eventos --
RABBITMQ_URL=amqps://adopti:${RABBITMQ_PASSWORD}@rabbitmq:5671/

# -- Base de datos (historial de notificaciones) --
POSTGRES_DSN=postgres://postgres:${POSTGRES_NOTIF_PASSWORD}@postgres-notifications:5432/notificationsdb?sslmode=verify-full&sslrootcert=/app/certs/ca.crt

# -- Firebase Admin (auth + FCM) --
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json
FIREBASE_CREDENTIALS=/app/firebase-credentials.json

# -- SendGrid (email) --
SENDGRID_API_KEY=${SENDGRID_API_KEY}
SENDGRID_FROM_EMAIL=adoptiapplication@gmail.com

# -- Email de pruebas --
TEST_EMAIL=test@example.com
